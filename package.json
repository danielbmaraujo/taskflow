{
  "name": "taskflow",
  "version": "1.0.0",
  "description": "TaskFlow - Gerenciador de Tarefas com testes Cypress",
  "scripts": {
    "install:all": "npm install && cd backend && npm install",
    "start:backend": "cd backend && node server.js",
    "dev:backend": "cd backend && npx nodemon server.js",
    "test:backend": "cypress run --spec 'cypress/e2e/backend.cy.js'",
    "test:frontend": "cypress run --spec 'cypress/e2e/frontend.cy.js'",
    "test:all": "cypress run",
    "cypress:open": "cypress open"
  },
  "devDependencies": {
    "cypress": "^13.6.0",
    "start-server-and-test": "^2.0.3"
  }
}
